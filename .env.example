# Only the benchmark harness needs these; the engine itself never calls an LLM.
# Every role is an OpenAI-compatible endpoint: <ROLE>_BASE_URL, <ROLE>_API_KEY, <ROLE>_MODEL (optional <ROLE>_RPM).

# Answering model, judge, the agent that writes summaries and facts, and Mem0's LLM (gpt-4.1-mini in the reported runs)
READER_BASE_URL=
READER_API_KEY=
READER_MODEL=gpt-4.1-mini

# Optional second judge (gpt-4o in the reported re-check)
OFFICIAL_JUDGE_BASE_URL=
OFFICIAL_JUDGE_API_KEY=
OFFICIAL_JUDGE_MODEL=gpt-4o
